# --- Public URLs ---
# Local: plain localhost so session cookies work across :3000 / :3001 / :3002
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_LEARN_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
# Leave empty locally. Production example: .workix.com (set BOTH)
COOKIE_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- S3 / R2 (videos + PDFs) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=workix-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://media.workix.com
S3_FORCE_PATH_STYLE=true

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SEAT_PRICE_ID=price_...

# --- Resend ---
RESEND_API_KEY=re_...
EMAIL_FROM=WORKIZ <hello@workiz.com>

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
INTERNAL_JOB_SECRET=change-me
