# Staging on the Hetzner VPS. Copy to the repo root as .env on the server, fill the secrets, then:
#   docker compose -f infra/docker-compose.yml --env-file .env up -d --build
# DNS (A records -> VPS IP): staging, www.staging, learn.staging, admin.staging, api.staging
# (or a wildcard *.staging plus staging itself). Ports 80/443 open for Let's Encrypt.

ROOT_DOMAIN=staging.workiz.net
ACME_EMAIL=you@workiz.net

# --- Public URLs (baked into the browser bundles at build time; rebuild after changing) ---
NEXT_PUBLIC_WEB_URL=https://staging.workiz.net
NEXT_PUBLIC_LEARN_URL=https://learn.staging.workiz.net
NEXT_PUBLIC_ADMIN_URL=https://admin.staging.workiz.net
NEXT_PUBLIC_API_URL=https://api.staging.workiz.net
# Shared session cookie across the staging subdomains (set BOTH)
COOKIE_DOMAIN=.staging.workiz.net
NEXT_PUBLIC_COOKIE_DOMAIN=.staging.workiz.net
NODE_ENV=production

# --- Supabase ---
# Also add the staging URLs to Supabase Auth > URL configuration (site URL + redirect URLs).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Video / media storage ---
# Recommended: Hetzner Object Storage (S3-compatible) so lectures play through short-lived
# signed HLS links. Leave MEDIA_* empty when S3 is used for videos.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=workiz-lecture-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_SECRET=

# --- Stripe (test mode on staging) ---
# Webhook endpoint: https://api.staging.workiz.net/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SEAT_PRICE_ID=price_...

# --- Resend (sending subdomain, e.g. send.workiz.net; does not touch root MX/SPF/DKIM) ---
RESEND_API_KEY=
EMAIL_FROM=WORKIZ <no-reply@send.workiz.net>

# --- Redis (the compose file overrides this to redis://redis:6379) ---
REDIS_URL=redis://redis:6379

API_PORT=4000
INTERNAL_JOB_SECRET=change-me-long-random
