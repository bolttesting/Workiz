FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS deps
ARG APP_NAME
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/package.json
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
ARG APP_NAME
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so they must be
# build args (.env is not copied into the image). docker-compose passes them from .env.
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_LEARN_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_COOKIE_DOMAIN
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_LEARN_URL=$NEXT_PUBLIC_LEARN_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_COOKIE_DOMAIN=$NEXT_PUBLIC_COOKIE_DOMAIN \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_TELEMETRY_DISABLED=1
COPY apps/${APP_NAME} ./apps/${APP_NAME}
RUN pnpm --filter @workix/${APP_NAME} build

FROM node:22-alpine AS runner
ARG APP_NAME
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    APP_NAME=${APP_NAME}
COPY --from=build /repo/apps/${APP_NAME}/.next/standalone ./
COPY --from=build /repo/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=build /repo/apps/${APP_NAME}/public ./apps/${APP_NAME}/public
EXPOSE 3000
# Shell form so ${APP_NAME} expands at runtime.
CMD node "apps/${APP_NAME}/server.js"
