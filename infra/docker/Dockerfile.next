FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/package.json
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
ARG APP_NAME
COPY apps/${APP_NAME} ./apps/${APP_NAME}
RUN pnpm --filter @workix/${APP_NAME} build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ARG APP_NAME
COPY --from=build /repo/apps/${APP_NAME}/.next/standalone ./
COPY --from=build /repo/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=build /repo/apps/${APP_NAME}/public ./apps/${APP_NAME}/public
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/${APP_NAME}/server.js"]
